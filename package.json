{
  "name": "applymate",
  "version": "0.1.0",
  "description": "Applymate \u2014 harness-agnostic job-application agent distro: a dossier-driven pipeline + local chat/review UI, operated by any AI CLI harness (Claude Code, Codex, Cursor, ZCode, Gemini CLI, ...).",
  "type": "module",
  "license": "MIT",
  "private": true,
  "author": "Mayank Asthana",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayankasthana/applymate.git"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "applymate": "bin/applymate.ts"
  },
  "scripts": {
    "test": "node --test --test-force-exit test/*.test.ts && npm run -s test:rig",
    "test:watch": "node --test --watch --test-force-exit test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "applymate": "node bin/applymate.ts",
    "test:rig": "python3 -m unittest discover -s browser-rig/tests"
  },
  "keywords": [
    "agent",
    "ai",
    "job-search",
    "resume",
    "agents-md",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
